{
  "name": "mirador",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Matías Barría (https://github.com/mata-2p)",
  "description": "Local web dashboard for running many coding agents on one Linux or WSL2 machine without filling its memory.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mata-2p/mirador.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "doctor": "node src/doctor.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit -p tsconfig.src.json",
    "typecheck:test": "node scripts/typecheck-report.ts",
    "export:check": "bash scripts/export-check.sh",
    "hooks:install": "sh scripts/install-hooks.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "0.28.2",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "6.0.3"
  }
}
