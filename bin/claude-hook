#!/usr/bin/env node
// Mirador's Claude Code hook. Mirador starts claude with
// `--settings <runtime>/mirador/herdr/claude-settings.json` (src/attention/claude-hooks.ts), whose
// hooks run this script with the event's JSON on stdin. It reports the agent's attention state as the
// gentle-shell bridge does, as one herdr report-metadata line to $HERDR_SOCKET_PATH for pane
// $HERDR_PANE_ID, from source mirador:attention:
//   UserPromptSubmit, PreToolUse,  working   clears blocked, prompt and finished; expires after WORKING_TTL_MS
//   PostToolUse
//   Notification                   waiting   prompt=<its message>; idle reminders and other notices change nothing
//   Stop                           finished  finished=<turn id>
// Waiting and finished never expire. Stop does not run when the user interrupts a turn, so each tool event
// re-sends working with the TTL: a cut turn reads `unknown` once no hook came for WORKING_TTL_MS.
// Each report also carries session=<session_id>, which Mirador records to resume with `--resume <id>`.
// For "where it left off" (src/memory/left-off.ts) it also sends, after that report and on the same
// connection, one `left-off` line with a documented hook field, cut to 16 KiB:
//   UserPromptSubmit  prompt (as received: pasted text already expanded in place)
//   Stop              last_assistant_message
//   PostCompact       compact_summary (no attention report)
//   SessionEnd        reason, as `reason` instead of `text` (no attention report; the server adds the time)
// The server validates and stores it; this script writes nothing. `--no-left-off` (config
// `leftOff: false`) sends the attention report only.
// Like bin/herdr-shim it must never get in the agent's way: it prints nothing, always exits 0 and
// gives up after one second.
import { createConnection } from 'node:net';

/** A prompt with pasted text expanded can be large: read up to this much, then give up on the event. */
const MAX_INPUT_BYTES = 4 * 1024 * 1024;
const MAX_LINE_BYTES = 4096;
/** As LEFT_OFF_MAX_TEXT_BYTES and TRUNCATED_MARK in src/memory/left-off.ts. */
const MAX_TEXT_BYTES = 16 * 1024;
const TRUNCATED_MARK = '…';
const MAX_LEFT_OFF_LINE_BYTES = 128 * 1024;
/** Which field of which event Mirador keeps for "where it left off". */
const LEFT_OFF_FIELDS = { UserPromptSubmit: 'prompt', Stop: 'last_assistant_message', PostCompact: 'compact_summary' };
/** As END_REASON in src/memory/left-off.ts: SessionEnd's reason (clear, logout, prompt_input_exit, other, …). */
const END_REASON = /^[a-z][a-z0-9_]{0,63}$/;
/** Mirador refuses a token value over 512 characters, so the message is cut before that. */
const MAX_MESSAGE = 500;
const TIMEOUT_MS = 1000;
const SOURCE = 'mirador:attention';
const PANE = /^[\w-]{1,64}$/;
/** As SESSION_ID in src/agents/catalog.ts: a letter or digit first, so never an option. */
const SESSION_ID = /^[A-Za-z0-9][\w-]{0,127}$/;
/** Notifications that wait for an answer (https://code.claude.com/docs/en/hooks#notification). */
const WAITING = new Set(['permission_prompt', 'elicitation_dialog', 'elicitation_url_dialog', 'agent_needs_input']);
const DEFAULT_PROMPT = 'Claude Code needs your input';
/** How long a working report stands without another hook (10 minutes); as WORKING_TTL_MS in bin/agy-hook. */
const WORKING_TTL_MS = 10 * 60 * 1000;

/** The hook's event object, or null when `input` is not one. */
function eventOf(input) {
  let event;
  try {
    event = JSON.parse(input);
  } catch {
    return null;
  }
  return typeof event === 'object' && event !== null && !Array.isArray(event) ? event : null;
}

/** `text` cut to MAX_TEXT_BYTES of UTF-8 between characters, with the marker when it was cut. */
function bound(text) {
  const bytes = Buffer.from(text, 'utf8');
  if (bytes.length <= MAX_TEXT_BYTES) return { text, truncated: false };
  let end = MAX_TEXT_BYTES - Buffer.byteLength(TRUNCATED_MARK);
  while (end > 0 && (bytes[end] & 0xc0) === 0x80) end--;
  return { text: bytes.subarray(0, end).toString('utf8') + TRUNCATED_MARK, truncated: true };
}

/** The left-off line for `event`, or null when it carries no such field or no valid session. */
function leftOffOf(event, pane) {
  if (typeof event.session_id !== 'string' || !SESSION_ID.test(event.session_id)) return null;
  if (event.hook_event_name === 'SessionEnd') {
    if (typeof event.reason !== 'string' || !END_REASON.test(event.reason)) return null;
    return JSON.stringify({ v: 1, cmd: 'left-off', pane, agent: 'claude-code', event: 'SessionEnd', session: event.session_id, reason: event.reason }) + '\n';
  }
  const field = Object.hasOwn(LEFT_OFF_FIELDS, event.hook_event_name) ? LEFT_OFF_FIELDS[event.hook_event_name] : null;
  const value = field ? event[field] : undefined;
  if (typeof value !== 'string' || !value.trim()) return null;
  const { text, truncated } = bound(value);
  const line = JSON.stringify({ v: 1, cmd: 'left-off', pane, agent: 'claude-code', event: event.hook_event_name, session: event.session_id, text, ...(truncated ? { truncated } : {}) }) + '\n';
  return Buffer.byteLength(line) <= MAX_LEFT_OFF_LINE_BYTES ? line : null;
}

/** The expiry, tokens and cleared tokens `event` reports, or null when it reports nothing. */
function reportOf(event, seq) {
  if (!event) return null;
  const session = typeof event.session_id === 'string' && SESSION_ID.test(event.session_id) ? { session: event.session_id } : {};
  switch (event.hook_event_name) {
    case 'UserPromptSubmit':
    case 'PreToolUse':
    case 'PostToolUse':
      return { ttlMs: WORKING_TTL_MS, tokens: session, clear: ['blocked', 'prompt', 'finished'] };
    case 'Notification': {
      // Older versions send no type: count it as waiting.
      if (event.notification_type !== undefined && !WAITING.has(event.notification_type)) return null;
      const message = typeof event.message === 'string' ? event.message.replace(/\s+/g, ' ').trim().slice(0, MAX_MESSAGE) : '';
      return { ttlMs: null, tokens: { ...session, prompt: message || DEFAULT_PROMPT }, clear: ['blocked', 'finished'] };
    }
    case 'Stop':
      return { ttlMs: null, tokens: { ...session, finished: String(seq) }, clear: ['blocked', 'prompt'] };
    default:
      return null;
  }
}

function send(socket, lines) {
  const conn = createConnection(socket);
  const timer = setTimeout(() => conn.destroy(), TIMEOUT_MS);
  conn.on('error', () => {});
  conn.on('close', () => clearTimeout(timer));
  conn.on('connect', () => conn.end(lines));
}

function main() {
  const leftOff = !process.argv.slice(2).includes('--no-left-off');
  const pane = process.env.HERDR_PANE_ID;
  const socket = process.env.HERDR_SOCKET_PATH;
  if (!pane || !PANE.test(pane) || !socket) return;
  setTimeout(() => process.exit(0), TIMEOUT_MS).unref();
  let input = '';
  let size = 0;
  process.stdin.setEncoding('utf8');
  process.stdin.on('error', () => {});
  process.stdin.on('data', (chunk) => {
    size += Buffer.byteLength(chunk);
    if (size > MAX_INPUT_BYTES) return process.stdin.destroy();
    input += chunk;
  });
  process.stdin.on('end', () => {
    // Numbered from the clock, as the bridge's reports are; one hook at a time keeps them in order.
    const seq = Date.now();
    const event = eventOf(input);
    const report = reportOf(event, seq);
    const lines = [];
    if (report) {
      const line = JSON.stringify({ v: 1, cmd: 'report-metadata', pane, source: SOURCE, seq, ...report }) + '\n';
      if (Buffer.byteLength(line) <= MAX_LINE_BYTES) lines.push(line);
    }
    const kept = leftOff && event ? leftOffOf(event, pane) : null;
    if (kept) lines.push(kept);
    if (lines.length) send(socket, lines.join(''));
  });
}

try {
  main();
} catch {
  // Best effort only: a report that cannot be sent is dropped.
}
process.exitCode = 0;
